{
  "plugins": ["react"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": "warn"
  },
  "overrides": [
    {
      "files": ["src/app/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ],
  "ignorePatterns": ["out/**", ".next/**"]
}
